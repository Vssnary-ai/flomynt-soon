# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: links for bottom buttons
NEXT_PUBLIC_VISIT_SITE_URL=https://flomynt.com
NEXT_PUBLIC_SPARKLE_URL=https://flomynt.com


# Admin Authentication
# ADMIN_PASSWORD_B64 = base64 of a bcrypt hash of your chosen password.
# (Base64, not the raw hash, so Next's .env loader can't mangle the "$"
# characters in the hash — see src/lib/adminAuth.ts for details.)
# Generate with:
#   node -e "const b=require('bcryptjs'); const h=b.hashSync('yourPassword',12); console.log(Buffer.from(h).toString('base64'))"
ADMIN_PASSWORD_B64=
SESSION_SECRET=

# Firebase Admin SDK service-account JSON (single line) — required for the
# admin dashboard to read real leads/wishlist data. See .env.local for the
# full explanation of why and how to generate it.
FIREBASE_SERVICE_ACCOUNT_KEY=
