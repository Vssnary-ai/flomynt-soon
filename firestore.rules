rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Waitlist collection: allow read and write
    match /waitlist/{docId} {
      allow read, write: if true;
    }

    // Wishlist collection: allow read and write
    match /wishlist/{docId} {
      allow read, write: if true;
    }

    // Leads collection: allow read, write, update, delete
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
